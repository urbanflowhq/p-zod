{
  "name": "@urbanflow/p-zod",
  "version": "0.1.0",
  "description": "Schema-driven probabilistic data modeling and sampling with Zod.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "check": "tsc -p tsconfig.check.json",
    "prepack": "npm run check && npm run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "npm run build && node --test",
    "docs:sync": "node scripts/sync-readme.mjs",
    "examples": "npm run build && node --test test/examples.test.mjs",
    "check:package": "npm run build && node scripts/check-package.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts",
    "release": "changeset publish"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "zod": "^4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/urbanflowhq/p-zod.git"
  },
  "homepage": "https://github.com/urbanflowhq/p-zod#readme",
  "bugs": {
    "url": "https://github.com/urbanflowhq/p-zod/issues"
  }
}
